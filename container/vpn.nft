table inet vpn_filter {
    chain input {
        type filter hook input priority filter; policy drop;

        ct state invalid drop
        iifname "lo" accept

        # The one public mode: standard WireGuard over UDP/443.
        iifname "outer0" udp dport 443 accept

        # Preserve useful path-error signalling for the encrypted outer flow.
        iifname "outer0" ip protocol icmp icmp type {
            destination-unreachable,
            time-exceeded,
            parameter-problem
        } accept

        # An authenticated peer may ping only the tunnel gateway itself. No
        # TCP or UDP service is reachable through wg0.
        iifname "wg0" ip saddr 10.77.0.0/24 \
            icmp type echo-request accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state invalid drop

        # These two addresses are the mandatory Haggai views. DNAT has already
        # changed their destinations to the private bridge transit addresses.
        iifname "wg0" oifname "haggai0" ip saddr 10.77.0.0/24 \
            ip daddr { 169.254.77.2, 169.254.77.3 } \
            meta l4proto { tcp, udp } ct mark 0x4d470001 accept
        iifname "haggai0" oifname "wg0" ip daddr 10.77.0.0/24 \
            ct mark 0x4d470001 ct state established,related accept

        # All other authenticated IPv4 traffic keeps the original unrestricted
        # host/LAN/Internet egress behavior.
        iifname "wg0" oifname "outer0" ip saddr 10.77.0.0/24 accept
        iifname "outer0" oifname "wg0" ip daddr 10.77.0.0/24 \
            ct state established,related accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
table ip vpn_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

        iifname "wg0" ip saddr 10.77.0.0/24 ip daddr 172.30.77.3 \
            meta l4proto { tcp, udp } \
            ct mark set 0x4d470001 dnat to 169.254.77.2
        iifname "wg0" ip saddr 10.77.0.0/24 ip daddr 172.30.77.4 \
            meta l4proto { tcp, udp } \
            ct mark set 0x4d470001 dnat to 169.254.77.3
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        oifname "haggai0" ip daddr { 169.254.77.2, 169.254.77.3 } \
            ct mark 0x4d470001 snat to 169.254.77.1
        oifname "outer0" ip saddr 10.77.0.0/24 masquerade
    }
}
